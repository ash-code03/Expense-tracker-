{
  "name": "expensetrack",
  "version": "1.0.0",
  "description": "Personal Expense Management System built with Node.js, Express, PostgreSQL, and Docker",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [
    "expense-tracker",
    "nodejs",
    "express",
    "postgresql",
    "docker",
    "devops"
  ],
  "author": "ExpenseTrack Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
